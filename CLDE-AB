package com.fartap

import android.app.Activity
import android.content.Intent
import android.os.Bundle
import android.provider.Settings
import android.widget.Button
import android.widget.LinearLayout
import android.widget.TextView

class MainActivity : Activity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        val pad = (24 * resources.displayMetrics.density).toInt()
        val layout = LinearLayout(this)
        layout.orientation = LinearLayout.VERTICAL
        layout.setPadding(pad, pad, pad, pad)

        val info = TextView(this)
        info.textSize = 16f
        info.text = "1. Tap the button below, find FarTap, and turn it on.\n\n" +
            "2. A blue button and a red target appear.\n\n" +
            "3. Long-press the blue button to unlock the red target, drag it over the far spot, then long-press the blue button again to lock it.\n\n" +
            "4. Drag the blue button next to your thumb. Tap it to tap the target."

        val open = Button(this)
        open.text = "Open Accessibility Settings"
        open.setOnClickListener {
            startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS))
        }

        layout.addView(info)
        layout.addView(open)
        setContentView(layout)
    }
}
```

**9. `app/src/main/java/com/fartap/TapService.kt`**
```kotlin
package com.fartap

import android.accessibilityservice.AccessibilityService
import android.accessibilityservice.GestureDescription
import android.graphics.Color
import android.graphics.Path
import android.graphics.PixelFormat
import android.graphics.drawable.GradientDrawable
import android.os.Handler
import android.os.Looper
import android.view.Gravity
import android.view.MotionEvent
import android.view.View
import android.view.WindowManager
import android.view.accessibility.AccessibilityEvent
import android.widget.Toast
import kotlin.math.abs

class TapService : AccessibilityService() {

    private lateinit var wm: WindowManager
    private lateinit var button: View
    private lateinit var marker: View
    private lateinit var buttonParams: WindowManager.LayoutParams
    private lateinit var markerParams: WindowManager.LayoutParams
    private val handler = Handler(Looper.getMainLooper())
    private var editMode = false

    private var startX = 0f
    private var startY = 0f
    private var origX = 0
    private var origY = 0
    private var moved = false
    private var longPressed = false

    private val longPressRunnable = Runnable {
        longPressed = true
        toggleEdit()
    }

    private val baseFlags = WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
        WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS

    override fun onServiceConnected() {
        super.onServiceConnected()
        wm = getSystemService(WINDOW_SERVICE) as WindowManager
        val dm = resources.displayMetrics
        val size = (56 * dm.density).toInt()

        button = View(this)
        button.background = circle(Color.argb(220, 33, 150, 243), Color.WHITE)
        buttonParams = makeParams(
            size,
            dm.widthPixels - size - 24,
            (dm.heightPixels * 0.7).toInt(),
            baseFlags
        )

        marker = View(this)
        marker.background = circle(Color.argb(60, 244, 67, 54), Color.RED)
        markerParams = makeParams(
            size,
            dm.widthPixels / 2 - size / 2,
            (dm.heightPixels * 0.12).toInt(),
            baseFlags or WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
        )

        setupButtonTouch()
        setupMarkerTouch()

        wm.addView(marker, markerParams)
        wm.addView(button, buttonParams)
    }

    private fun circle(fill: Int, stroke: Int): GradientDrawable {
        val d = GradientDrawable()
        d.shape = GradientDrawable.OVAL
        d.setColor(fill)
        d.setStroke(4, stroke)
        return d
    }

    private fun makeParams(size: Int, x: Int, y: Int, flags: Int): WindowManager.LayoutParams {
        val p = WindowManager.LayoutParams(
            size,
            size,
            WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,
            flags,
            PixelFormat.TRANSLUCENT
        )
        p.gravity = Gravity.TOP or Gravity.START
        p.x = x
        p.y = y
        return p
    }

    private fun setupButtonTouch() {
        button.setOnTouchListener { _, e ->
            when (e.actionMasked) {
                MotionEvent.ACTION_DOWN -> {
                    startX = e.rawX
                    startY = e.rawY
                    origX = buttonParams.x
                    origY = buttonParams.y
                    moved = false
                    longPressed = false
                    handler.postDelayed(longPressRunnable, 600)
                }
                MotionEvent.ACTION_MOVE -> {
                    val dx = e.rawX - startX
                    val dy = e.rawY - startY
                    if (abs(dx) > 12 || abs(dy) > 12) {
                        moved = true
                        handler.removeCallbacks(longPressRunnable)
                    }
                    if (moved) {
                        buttonParams.x = origX + dx.toInt()
                        buttonParams.y = origY + dy.toInt()
                        wm.updateViewLayout(button, buttonParams)
                    }
                }
                MotionEvent.ACTION_UP -> {
                    handler.removeCallbacks(longPressRunnable)
                    if (!moved && !longPressed) fireTap()
                }
                MotionEvent.ACTION_CANCEL -> handler.removeCallbacks(longPressRunnable)
            }
            true
        }
    }

    private fun setupMarkerTouch() {
        marker.setOnTouchListener { _, e ->
            when (e.actionMasked) {
                MotionEvent.ACTION_DOWN -> {
                    startX = e.rawX
                    startY = e.rawY
                    origX = markerParams.x
                    origY = markerParams.y
                }
                MotionEvent.ACTION_MOVE -> {
                    markerParams.x = origX + (e.rawX - startX).toInt()
                    markerParams.y = origY + (e.rawY - startY).toInt()
                    wm.updateViewLayout(marker, markerParams)
                }
            }
            true
        }
    }

    private fun toggleEdit() {
        editMode = !editMode
        markerParams.flags = if (editMode) {
            baseFlags
        } else {
            baseFlags or WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
        }
        wm.updateViewLayout(marker, markerParams)
        Toast.makeText(
            this,
            if (editMode) "Drag the red target, then long-press blue to lock" else "Target locked",
            Toast.LENGTH_SHORT
        ).show()
    }

    private fun fireTap() {
        if (editMode) return
        val loc = IntArray(2)
        marker.getLocationOnScreen(loc)
        val cx = loc[0] + marker.width / 2f
        val cy = loc[1] + marker.height / 2f
        val path = Path()
        path.moveTo(cx, cy)
        val gesture = GestureDescription.Builder()
            .addStroke(GestureDescription.StrokeDescription(path, 0, 50))
            .build()
        dispatchGesture(gesture, null, null)
    }

    override fun onAccessibilityEvent(event: AccessibilityEvent?) {}

    override fun onInterrupt() {}

    override fun onDestroy() {
        super.onDestroy()
        try {
            wm.removeView(button)
            wm.removeView(marker)
        } catch (e: Exception) {
        }
    }
}
